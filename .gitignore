node_modules/
dist/
*.tsbuildinfo
.DS_Store
.env
.env.local
# Local toolchain / verification artifacts.
.pnpm-store/
.npm-cache/
.tmp-build/
packages/**/.tmp-build/

# Build output — regenerate with `pnpm build`.
packages/*/lib/*
# ...EXCEPT the typert-generated Remote artifacts. Those are build INPUTS: the client
# half imports `<pkg>/remote`, and re-generating them requires a DeepSeek Harness
# source checkout, so they are vendored here to keep a plain clone buildable.
# Refresh with `pnpm gen:typert` when a @Remote contract changes (see AGENTS.md).
!packages/*/lib/typert.host.js
!packages/*/lib/typert.host.d.ts
!packages/*/lib/typert.remote-client.js
!packages/*/lib/typert.remote-client.d.ts
!packages/*/lib/typert.remote-client.d.ts.map

# cordis.yml is generated by scripts/gen-cordis-yml.mjs and holds only bare package
# names, so it is safe to keep tracked.
