{
  "name": "@dsh-plugins/bundled-skills",
  "description": "Agent Skills shipped with dsh-pluginHive, bootstrapped into the user's skills directory by the skill panel.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "skills/**/*"
  ],
  "author": "seanchen88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanchen88/dsh-pluginHive.git",
    "directory": "packages/bundled-skills"
  },
  "bugs": {
    "url": "https://github.com/seanchen88/dsh-pluginHive/issues"
  },
  "homepage": "https://github.com/seanchen88/dsh-pluginHive#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agent-skill"
  ]
}
