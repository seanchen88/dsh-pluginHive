{
  "name": "@dsh-plugins/bundled-skills",
  "description": "Skills shipped with the DeepSeek Harness plugin set (single source of truth for panel-bootstrapped skills such as create-skill).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "skills/**/*"
  ]
}
