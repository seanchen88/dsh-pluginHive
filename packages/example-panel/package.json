{
  "name": "@dsh-plugins/example-panel",
  "description": "Copy-me template for building a new DeepSeek Harness management panel on top of plugin-kit.",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@dsh-plugins/plugin-kit": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "author": "seanchen88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanchen88/dsh-pluginHive.git",
    "directory": "packages/example-panel"
  },
  "bugs": {
    "url": "https://github.com/seanchen88/dsh-pluginHive/issues"
  },
  "homepage": "https://github.com/seanchen88/dsh-pluginHive#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin"
  ]
}
