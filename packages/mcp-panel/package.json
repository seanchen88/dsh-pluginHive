{
  "name": "@dsh-plugins/mcp-panel",
  "description": "MCP services management panel for DeepSeek Harness: list, add, edit, enable/disable and delete MCP servers through the profile patch layer.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-app-boot": "*",
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-hmr": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0",
    "@dsh-plugins/plugin-kit": "workspace:*",
    "zod": "^3.25.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.d.ts"
  ],
  "author": "seanchen88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanchen88/dsh-pluginHive.git",
    "directory": "packages/mcp-panel"
  },
  "bugs": {
    "url": "https://github.com/seanchen88/dsh-pluginHive/issues"
  },
  "homepage": "https://github.com/seanchen88/dsh-pluginHive#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "mcp"
  ]
}
