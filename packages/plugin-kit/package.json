{
  "name": "@dsh-plugins/plugin-kit",
  "description": "Shared base for DeepSeek Harness management panels: panel registration, Remote proxies, locale helper, self-contained UI controls and the client-bundle tsdown preset.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.7.0"
  },
  "author": "seanchen88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanchen88/dsh-pluginHive.git",
    "directory": "packages/plugin-kit"
  },
  "bugs": {
    "url": "https://github.com/seanchen88/dsh-pluginHive/issues"
  },
  "homepage": "https://github.com/seanchen88/dsh-pluginHive#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin"
  ]
}
