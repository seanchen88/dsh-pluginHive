{
  "name": "@dsh-plugins/plugin-kit",
  "description": "Shared base for DeepSeek Harness management panels: slot/panel helpers, single-flight remote cache, locale registration, and copied UI controls (theme-token only, no runtime dependency on harness client packages).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.7.0"
  }
}
